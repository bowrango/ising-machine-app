TEXT -384 720 Left 2 ;Oscillator start-up: cross-coupled SN74HC240 LC oscillator (oscillator-schematic.PDF p2).
TEXT -384 756 Left 2 ;X1/X2: HC240 inverters (hcinv: tanh transfer, gain at Vcc/2). R1/R2: Rout + 1k, open until SW1 enables the outputs at Ton.
TEXT -384 792 Left 2 ;Cr: 1 pF imbalance so the symmetric circuit can start in simulation.
TEXT -384 828 Left 2 !.subckt hcinv in out\nB1 out 0 V=Vcc/2*(1-tanh(2*gain*(V(in)-Vcc/2)/Vcc))\n.ends hcinv
TEXT -384 936 Left 2 !.param Lt=30.6u Q=40 Ct=750p Rs=1k Rout=60 Vcc=3.3 gain=30 Cnode=10p Ton=5u
TEXT -384 972 Left 2 !.model DCLAMP D(Is=1e-14 N=1 Rs=10)
TEXT -384 1008 Left 2 !.tran 0 60u 0 2n
TEXT -384 1044 Left 2 !.meas tran t1 when V(l,r)=0 rise=40
TEXT -384 1080 Left 2 !.meas tran t2 when V(l,r)=0 rise=50
TEXT -384 1116 Left 2 !.meas tran freq param 10/(t2-t1)
TEXT -384 1152 Left 2 !.meas tran vmin min V(l) from 40u to 60u
TEXT -384 1188 Left 2 !.meas tran vmax max V(l) from 40u to 60u
TEXT -384 1224 Left 2 !.meas tran vpp param vmax-vmin
TEXT -384 1260 Left 2 !.meas tran tstart when V(l,r)=1 rise=1
TEXT -384 1296 Left 2 !.meas tran startup param tstart-Ton
TEXT -384 1332 Left 2 !.meas tran tfull when V(l,r)=3.06 rise=1
TEXT -384 1368 Left 2 !.meas tran full param tfull-Ton
